# Environment variables — DigiLib SMA
# Copy file ini ke .env dan isi nilainya

# Database (SQLite)
DATABASE_URL="file:./dev.db"

# NextAuth — WAJIB diganti dengan nilai acak yang kuat di production
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="GANTI_DENGAN_NILAI_ACAK_YANG_KUAT"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider — konfigurasi utama melalui UI ADMIN "Konfigurasi AI".
# Variabel ini hanya fallback bila BELUM ada konfigurasi aktif di database.
# Provider didukung: NVIDIA NIM, Google Gemini (native), Groq, OpenRouter.
# AI_PROVIDER (opsional): NVIDIA | GEMINI | GROQ | OPENROUTER. Bila kosong,
# provider disimpulkan dari host AI_BASE_URL.
#
# Daftar model yang tersedia untuk akun Anda:
#   curl "<AI_BASE_URL>/models" -H "Authorization: Bearer <AI_API_KEY>"
#
# Contoh NVIDIA NIM:
#   AI_PROVIDER="NVIDIA"
#   AI_BASE_URL="https://integrate.api.nvidia.com/v1"
#   AI_MODEL="meta/llama-3.2-11b-vision-instruct"
#   AI_FALLBACK_MODELS="nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3-ultra-550b-a55b"
AI_PROVIDER=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_API_KEY=""
# Model cadangan, dipisah koma. Dicoba otomatis bila model utama gagal.
AI_FALLBACK_MODELS=""
# "false" mengaktifkan mode thinking NVIDIA (default dimatikan).
AI_DISABLE_THINKING="true"

# Kunci enkripsi API key yang disimpan di database (AES-256-GCM).
# WAJIB stabil di production. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Jika kosong, NEXTAUTH_SECRET dipakai sebagai turunan kunci. Jangan mengganti
# nilai ini setelah konfigurasi AI disimpan; secret lama tidak dapat didekripsi.
AI_CONFIG_ENCRYPTION_KEY=""

# Batas waktu provider AI (opsional; nilai default sudah cukup untuk model
# reasoning yang lambat). Uji koneksi dibuat lebih longgar dari request biasa
# agar model yang menjawab >50 detik tidak salah dianggap API key tidak valid.
# AI_REQUEST_TIMEOUT_MS="75000"
# AI_TOTAL_BUDGET_MS="120000"
# AI_CONNECTION_TEST_TIMEOUT_MS="90000"

# Telegram Bot — notifikasi tambahan (opsional).
# Kosongkan TELEGRAM_BOT_TOKEN untuk menonaktifkan sepenuhnya; notifikasi in-app
# DigiLib tetap berjalan normal. Isi token HANYA di file .env (jangan di-commit).
# Telegram hanya dikirim ke peminjam: TEACHER (Guru), STUDENT (Siswa), dan
# STAFF (Staf Sekolah). ADMIN dan LIBRARIAN tidak menerima Telegram.
TELEGRAM_BOT_TOKEN=""
# Setel "false" untuk mematikan pengiriman Telegram tanpa menghapus token.
TELEGRAM_ENABLED="true"
# Username bot tanpa "@" (dipakai untuk membangun tautan pengaitan di Profil).
TELEGRAM_BOT_USERNAME=""
# Rahasia header webhook (X-Telegram-Bot-Api-Secret-Token). Isi nilai acak.
TELEGRAM_WEBHOOK_SECRET=""
